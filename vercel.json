{
  "outputDirectory": ".",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/Home.dc.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Menu.dc.html",
      "destination": "/menu",
      "permanent": true
    },
    {
      "source": "/Order.dc.html",
      "destination": "/order",
      "permanent": true
    },
    {
      "source": "/Catering.dc.html",
      "destination": "/catering",
      "permanent": true
    },
    {
      "source": "/About.dc.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/Reviews.dc.html",
      "destination": "/reviews",
      "permanent": true
    },
    {
      "source": "/Blog.dc.html",
      "destination": "/journal",
      "permanent": true
    },
    {
      "source": "/Contact.dc.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/journal",
      "permanent": true
    },
    {
      "source": "/ThankYou.dc.html",
      "destination": "/thank-you",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/journal/_ds/:path*",
      "destination": "/_ds/:path*"
    },
    {
      "source": "/journal/public/:path*",
      "destination": "/public/:path*"
    },
    {
      "source": "/journal/support.js",
      "destination": "/support.js"
    },
    {
      "source": "/journal/analytics.js",
      "destination": "/analytics.js"
    },
    {
      "source": "/journal/SiteHeader.dc.html",
      "destination": "/SiteHeader.dc.html"
    },
    {
      "source": "/journal/SiteFooter.dc.html",
      "destination": "/SiteFooter.dc.html"
    },
    {
      "source": "/menu",
      "destination": "/Menu.dc.html"
    },
    {
      "source": "/catering",
      "destination": "/Catering.dc.html"
    },
    {
      "source": "/order",
      "destination": "/Order.dc.html"
    },
    {
      "source": "/about",
      "destination": "/About.dc.html"
    },
    {
      "source": "/reviews",
      "destination": "/Reviews.dc.html"
    },
    {
      "source": "/journal",
      "destination": "/Blog.dc.html"
    },
    {
      "source": "/contact",
      "destination": "/Contact.dc.html"
    },
    {
      "source": "/privacy",
      "destination": "/Privacy.dc.html"
    },
    {
      "source": "/thank-you",
      "destination": "/ThankYou.dc.html"
    },
    {
      "source": "/journal/what-is-kothu-parotta",
      "destination": "/ArticleKothuParotta.dc.html"
    },
    {
      "source": "/journal/seeraga-samba-biryani",
      "destination": "/ArticleSeeragaSamba.dc.html"
    },
    {
      "source": "/journal/what-is-jigarthanda",
      "destination": "/ArticleJigarthanda.dc.html"
    },
    {
      "source": "/journal/first-time-tamil-food-guide",
      "destination": "/ArticleFirstTimeGuide.dc.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/seo/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/seo/robots.txt"
    }
  ],
  "headers": [
    {
      "source": "/public/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_ds/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/journal/public/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://unpkg.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com https://www.facebook.com https://googleads.g.doubleclick.net https://www.google.com https://www.google.com.au; connect-src 'self' https://formspree.io https://www.google-analytics.com https://*.google-analytics.com https://stats.g.doubleclick.net https://www.googletagmanager.com https://connect.facebook.net; frame-src https://www.google.com https://widgets.sociablekit.com https://*.sociablekit.com; form-action 'self' https://formspree.io; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(Home|Menu|Order|Catering|About|Reviews|Blog|Contact|Privacy|ThankYou|SiteHeader|SiteFooter|Article[A-Za-z]+)\\.dc\\.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}