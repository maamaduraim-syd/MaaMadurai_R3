{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/cards/**",
              "components/feedback/**",
              "components/forms/**",
              "components/icons/**",
              "components/navigation/**",
              "components/social/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cinzel|Poppins|Noto Sans Tamil))/i]",
        "message": "Font not provided by the design system. Available: Cinzel, Poppins, Noto Sans Tamil."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|dark)$/]",
        "message": "<Badge> tone must be one of 'gold' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|children|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|tab|tabActive|outline)$/]",
        "message": "<Button> variant must be one of 'solid' | 'tab' | 'tabActive' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:categories|active|onChange|extra|key|ref|className|style|children)$/]",
        "message": "<CategoryTabs> doesn't accept that prop. Declared props: categories, active, onChange, extra."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:map-pin|leaf|flame|chevron-left|chevron-right|heart|message-circle|mail|phone|clock|utensils-crossed|facebook|instagram|tripadvisor|ubereats|doordash)$/]",
        "message": "<Icon> name must be one of 'map-pin' | 'leaf' | 'flame' | 'chevron-left' | 'chevron-right' | 'heart' | 'message-circle' | 'mail' | 'phone' | 'clock' | 'utensils-crossed' | 'facebook' | 'instagram' | 'tripadvisor' | 'ubereats' | 'doordash'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|name|value|placeholder|error|onChange|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: type, name, value, placeholder, error, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuHighlightCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|key|ref|className|style|children)$/]",
        "message": "<MenuHighlightCard> doesn't accept that prop. Declared props: image, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItemRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|price|isVeg|isSpicy|key|ref|className|style|children)$/]",
        "message": "<MenuItemRow> doesn't accept that prop. Declared props: title, price, isVeg, isSpicy."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<SectionPanel> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialIconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|href|size|key|ref|className|style|children)$/]",
        "message": "<SocialIconButton> doesn't accept that prop. Declared props: icon, href, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|value|placeholder|rows|error|onChange|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: name, value, placeholder, rows, error, onChange."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
